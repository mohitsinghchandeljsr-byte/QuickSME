  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set timestamp for requests",
          "pm.globals.set(\"timestamp\", new Date().toISOString());",
          "",
          "// Generate random test data",
          "pm.globals.set(\"randomInt\", Math.floor(Math.random() * 1000));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test scripts",
          "pm.test(\"Status code is not 5xx\", function () {",
          "    pm.response.to.not.be.serverError;",
          "});",
          "",
          "pm.test(\"Response time is less than 2000ms\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "pm.test(\"Response has proper headers\", function () {",
          "    pm.response.to.have.header(\"Content-Type\");",
          "});",
          "",
          "// Store IDs for dependent requests",
          "if (pm.response.code === 201 && pm.response.json().id) {",
          "    var endpoint = pm.request.url.path[pm.request.url.path.length - 1];",
          "    if (endpoint === 'ledgers') {",
          "        pm.collectionVariables.set(\"ledgerId\", pm.response.json().id);",
          "    } else if (endpoint === 'parties') {",
          "        pm.collectionVariables.set(\"partyId\", pm.response.json().id);",
          "    } else if (endpoint === 'vouchers') {",
          "        pm.collectionVariables.set(\"voucherId\", pm.response.json().id);",
          "    } else if (endpoint === 'stock') {",
          "        pm.collectionVariables.set(\"stockItemId\", pm.response.json().id);",
          "    } else if (endpoint === 'api-keys') {",
          "        pm.collectionVariables.set(\"apiKeyId\", pm.response.json().id);",
          "    } else if (endpoint === 'webhooks') {",
          "        pm.collectionVariables.set(\"webhookId\", pm.response.json().id);",
          "    }",
          "}",
          "",
          "// Validate JSON response structure",
          "if (pm.response.headers.get(\"Content-Type\") && pm.response.headers.get(\"Content-Type\").includes(\"application/json\")) {",
          "    pm.test(\"Response is valid JSON\", function () {",
          "        pm.response.json();",
          "    });",
          "}"
        ]
      }
    }
  ]
